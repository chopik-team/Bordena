{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bordena",
  "version": "../../../package.json",
  "identifier": "team.chopik.bordena",
  "build": {
    "beforeDevCommand": "pnpm --filter client dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "pnpm --filter client build",
    "frontendDist": "../../client/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Bordena",
        "width": 1280,
        "height": 800,
        "minWidth": 640,
        "minHeight": 480,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "dragDropEnabled": false,
        "create": false
      },
      {
        "label": "quick-note",
        "title": "Быстрая заметка — Bordena",
        "url": "/quick-note",
        "width": 768,
        "height": 440,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "resizable": false,
        "skipTaskbar": true,
        "center": true,
        "dragDropEnabled": false,
        "create": false
      },
      {
        "label": "tear-ghost",
        "title": "Bordena",
        "url": "/tear-ghost.html",
        "width": 128,
        "height": 128,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "resizable": false,
        "focus": false,
        "focusable": false,
        "skipTaskbar": true,
        "dragDropEnabled": false,
        "create": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'; media-src 'self' blob: asset: http://asset.localhost",
      "devCsp": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data:; font-src 'self' data:; connect-src 'self' ws://127.0.0.1:5173 ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'; media-src 'self' blob: asset: http://asset.localhost",
      "assetProtocol": {
        "scope": [],
        "enable": true
      }
    },
    "macOSPrivateApi": false
  },
  "bundle": {
    "active": true,
    "useLocalToolsDir": true,
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": false,
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Russian",
          "English"
        ],
        "displayLanguageSelector": false,
        "installerHooks": "./windows/hooks.nsh"
      },
      "allowDowngrades": false
    },
    "publisher": "CHOPIK Team",
    "shortDescription": "Offline project manager",
    "longDescription": "Bordena is a free, local-first project management application for Windows.",
    "copyright": "Copyright © 2026 Stanislav Smirnov, CHOPIK Team; Doska © 2026 Margarita Romenkova",
    "resources": {
      "../../../NOTICE.md": "licenses/NOTICE.md",
      "../../../LICENSE": "licenses/Bordena-MIT.txt",
      "../../../docs/THIRD_PARTY_NOTICES.txt": "licenses/frontend.txt",
      "../../../docs/RUST_THIRD_PARTY_NOTICES.txt": "licenses/rust.txt",
      "../../../docs/licenses/mpl-sources/": "licenses/mpl-sources/"
    }
  },
  "plugins": {}
}
